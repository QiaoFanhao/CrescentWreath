# =========================
# Root gitignore for CrescentWreath mono-repo
# =========================

# ---------- Common ----------
.DS_Store
Thumbs.db
*.log
.vs/
.idea/
.gradle/
TestResults/

# ---------- .NET / C# ----------
**/bin/
**/obj/
*.user
*.rsuser
*.suo
*.tmp
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.csproj
*.sln
*.slnx

# UnityClient local generated project artifacts (do not track)
UnityClient/CrescentWreathClinet/*.csproj
UnityClient/CrescentWreathClinet/*.sln
UnityClient/CrescentWreathClinet/*.slnx
UnityClient/CrescentWreathClinet/*.csproj.lscache
*.lscache

# ---------- Unity (only relevant for UnityClient or future Unity project dirs) ----------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
ExportedObj/
sysinfo.txt
mono_crash.*

# Unity generated / optional
*.unitypackage
*.unitypackage.meta
*.apk
*.aab
*.app

# Addressables
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Rider / JetBrains
*.DotSettings.user
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Scripting
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# ---------- Optional local artifacts ----------
*.zip
~$*
UnityClient/CrescentWreathClinet/Assets/*.zip.meta
UnityClient/CrescentWreathClinet/Assets/_Recovery/
Assets/_Recovery/
**/_Recovery/
UnityClient/Pac/
build_tests_diag.txt
build_tests_msbuild_diag.txt

# ---------- Licensed local-only assets ----------
# Commercial source assets are intentionally kept out of the public repository.
UnityClient/CrescentWreathClinet/Assets/Art/Eric VFX Studio/
UnityClient/CrescentWreathClinet/Assets/Art/Eric VFX Studio.meta
UnityClient/CrescentWreathClinet/Assets/Art/SE/
UnityClient/CrescentWreathClinet/Assets/Art/SE.meta

# ---------- Local environment / tooling caches ----------
bin/
obj/
.vscode/
.dotnet/
.dotnet_cli/
.dotnet_home/
.dotnet-home/
.claude/
*.trn
